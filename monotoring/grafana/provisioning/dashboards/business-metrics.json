        "tooltip": { "mode": "details" },
        "view": { "id": "auto" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "TimescaleDB" },
          "format": "table",
          "rawSql": "SELECT DISTINCT ON (vehicule_id) \"time\" AS time, latitude AS latitude, longitude AS longitude, vehicule_id AS vehicle FROM positions_gps ORDER BY vehicule_id, \"time\" DESC;",
