    {
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "description": "Derniere position GPS de chaque vehicule.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 },
      "id": 10,
      "options": {
        "controls": { "showScale": true, "showZoom": true },
        "layers": [
          {
            "type": "markers",
            "name": "Positions",
            "config": {
              "showLegend": false,
              "style": { "color": "red", "size": 10 }
