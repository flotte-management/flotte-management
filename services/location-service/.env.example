# HTTP / gRPC
PORT=3000
GRPC_PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=location_db
DB_USER=postgres
DB_PASSWORD=secret
DB_AUTO_BOOTSTRAP=true
DB_ALLOW_START_WITHOUT_DATABASE=false

# Keycloak
KEYCLOAK_REALM_URL=http://localhost:8080/realms/flotte-management
KEYCLOAK_VERIFY_ISSUER=false
JWT_PUBLIC_KEY=

# Kafka
KAFKA_ENABLED=false
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=location-service
KAFKA_TOPIC=location-domain-events

# AI
AI_AGENT_ENABLED=true

